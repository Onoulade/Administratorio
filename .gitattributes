# Set the default behavior to automatically detect text files and perform LF normalization
* text=auto

# files that should not be modified
*.png binary
*.ogg binary
*.blend binary export-ignore

# files that should not get included in a release zip
README.md export-ignore
CONTRIBUTING.md export-ignore
.vscode/** export-ignore
.git/** export-ignore
.github/** export-ignore
.gitignore export-ignore
.gitattributes export-ignore
Internal export-ignore
Internal/** export-ignore
tests export-ignore
tests/** export-ignore
tools export-ignore
tools/** export-ignore

# Factorio Mod Portal rejects executable/script files in uploaded mods
*.exe export-ignore
*.bat export-ignore
*.ps1 export-ignore
*.sh export-ignore
*.py export-ignore
